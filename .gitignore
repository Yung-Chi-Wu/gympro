*.tfplan
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
infra/terraform/out.json

# Supabase CLI local cache
supabase/.temp/

# Claude Code per-machine settings (permissions, local paths)
.claude/settings.local.json
