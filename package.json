{
  "name": "gympro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "eval:ronnie:build": "lambda/ai-worker/node_modules/.bin/esbuild evals/ronnie/entry.ts --bundle --platform=node --target=node20 --format=cjs --outfile=evals/ronnie/dist/ronnie.cjs",
    "typecheck:evals": "tsc --noEmit -p evals/ronnie && tsc --noEmit -p evals/search && tsc --noEmit -p evals/knowledge && tsc --noEmit -p scripts",
    "eval:knowledge": "lambda/ai-worker/node_modules/.bin/esbuild evals/knowledge/run.ts --bundle --platform=node --target=node20 --format=cjs --outfile=evals/knowledge/dist/run.cjs --log-level=warning && node evals/knowledge/dist/run.cjs",
    "eval:search": "lambda/ai-worker/node_modules/.bin/esbuild evals/search/run.ts --bundle --platform=node --target=node20 --format=cjs --outfile=evals/search/dist/run.cjs --log-level=warning && node evals/search/dist/run.cjs",
    "check:knowledge": "lambda/ai-worker/node_modules/.bin/esbuild scripts/check-knowledge.ts --bundle --platform=node --target=node20 --format=cjs --outfile=scripts/dist/check-knowledge.cjs --log-level=warning && node scripts/dist/check-knowledge.cjs",
    "index:knowledge": "lambda/ai-worker/node_modules/.bin/esbuild scripts/index-knowledge-embeddings.ts --bundle --platform=node --target=node20 --format=cjs --outfile=scripts/dist/index-knowledge-embeddings.cjs --log-level=warning && AWS_REGION=${AWS_REGION:-us-east-1} node --experimental-websocket scripts/dist/index-knowledge-embeddings.cjs",
    "check:evidence": "lambda/ai-worker/node_modules/.bin/esbuild scripts/check-evidence.ts --bundle --platform=node --target=node20 --format=cjs --outfile=scripts/dist/check-evidence.cjs --log-level=warning && node scripts/dist/check-evidence.cjs",
    "check:browser-env": "lambda/ai-worker/node_modules/.bin/esbuild scripts/check-browser-env.ts --bundle --platform=node --target=node20 --format=cjs --outfile=scripts/dist/check-browser-env.cjs --log-level=warning && node scripts/dist/check-browser-env.cjs",
    "check:coach-g": "lambda/ai-worker/node_modules/.bin/esbuild scripts/check-coach-g.ts --bundle --platform=node --target=node20 --format=cjs --outfile=scripts/dist/check-coach-g.cjs --log-level=warning && node scripts/dist/check-coach-g.cjs",
    "check:app-errors": "lambda/ai-worker/node_modules/.bin/esbuild scripts/check-app-errors.ts --bundle --platform=node --target=node20 --format=cjs --outfile=scripts/dist/check-app-errors.cjs --log-level=warning && node scripts/dist/check-app-errors.cjs",
    "check:data-writes": "lambda/ai-worker/node_modules/.bin/esbuild scripts/check-data-writes.ts --bundle --platform=node --target=node20 --format=cjs --outfile=scripts/dist/check-data-writes.cjs --log-level=warning --external:typescript && node scripts/dist/check-data-writes.cjs",
    "check:time-zone": "lambda/ai-worker/node_modules/.bin/esbuild scripts/check-time-zone.ts --bundle --platform=node --target=node20 --format=cjs --outfile=scripts/dist/check-time-zone.cjs --log-level=warning && node scripts/dist/check-time-zone.cjs",
    "check:limits": "lambda/ai-worker/node_modules/.bin/esbuild scripts/check-limits.ts --bundle --platform=node --target=node20 --format=cjs --outfile=scripts/dist/check-limits.cjs --log-level=warning && node scripts/dist/check-limits.cjs",
    "check:exercise-picker": "lambda/ai-worker/node_modules/.bin/esbuild scripts/check-exercise-picker.ts --bundle --platform=node --target=node20 --format=cjs --outfile=scripts/dist/check-exercise-picker.cjs --log-level=warning && node scripts/dist/check-exercise-picker.cjs",
    "index:exercises": "lambda/ai-worker/node_modules/.bin/esbuild scripts/index-exercise-embeddings.ts --bundle --platform=node --target=node20 --format=cjs --outfile=scripts/dist/index-exercise-embeddings.cjs --log-level=warning && AWS_REGION=${AWS_REGION:-us-east-1} node --experimental-websocket scripts/dist/index-exercise-embeddings.cjs",
    "trace:to-case": "lambda/ai-worker/node_modules/.bin/esbuild scripts/trace-to-case.ts --bundle --platform=node --target=node20 --format=cjs --outfile=scripts/dist/trace-to-case.cjs --log-level=warning && AWS_REGION=${AWS_REGION:-us-east-1} node scripts/dist/trace-to-case.cjs",
    "exercise-attributes": "lambda/ai-worker/node_modules/.bin/esbuild scripts/exercise-attributes.ts --bundle --platform=node --target=node20 --format=cjs --outfile=scripts/dist/exercise-attributes.cjs --log-level=warning && node scripts/dist/exercise-attributes.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1148.0",
    "@aws-sdk/client-sqs": "^3.1112.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@vercel/oidc-aws-credentials-provider": "^3.3.11",
    "next": "16.4.3",
    "next-intl": "^4.13.7",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^2.15.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "supabase": "^2.114.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "4.6.7"
    }
  }
}
